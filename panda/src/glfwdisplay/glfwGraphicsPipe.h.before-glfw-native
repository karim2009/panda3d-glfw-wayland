#ifndef GLFWGRAPHICSPIPE_H
#define GLFWGRAPHICSPIPE_H

#include "pandabase.h"
#include "graphicsPipe.h"
struct GLFWwindow;
class glfwGraphicsWindow;

class glfwGraphicsPipe : public GraphicsPipe {
public:
  glfwGraphicsPipe();
  virtual ~glfwGraphicsPipe();

  virtual std::string get_interface_name() const;

  static PT(GraphicsPipe) pipe_constructor();

protected:
  virtual PT(GraphicsStateGuardian) make_callback_gsg(GraphicsEngine *engine);
  virtual PT(GraphicsOutput) make_output(
    std::string_view name,
    const FrameBufferProperties &fb_prop,
    const WindowProperties &win_prop,
    int flags,
    GraphicsEngine *engine,
    GraphicsStateGuardian *gsg,
    GraphicsOutput *host,
    int retry,
    bool &precertify
  );

public:
  static TypeHandle get_class_type() {
    return _type_handle;
  }

  static void init_type() {
    GraphicsPipe::init_type();
    register_type(_type_handle, "glfwGraphicsPipe",
                  GraphicsPipe::get_class_type());
  }

  virtual TypeHandle get_type() const {
    return get_class_type();
  }

  virtual TypeHandle force_init_type() {
    init_type();
    return get_class_type();
  }

private:
  static TypeHandle _type_handle;
};

#endif
